# رابط ومفاتيح مشروع Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# مفتاح الخدمة السري — لا يُستخدم في مسارات النماذج العامة (محمية بالكامل عبر RLS)،
# ويُستخدم فقط في سكربتات الإدارة المحلية مثل إنشاء أول حساب أدمن. لا تكشفه أبدًا في الواجهة.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# اسم المنصة والرابط العام (قابلة للتغيير بسهولة)
NEXT_PUBLIC_SITE_NAME="هبة الجزائر"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# معرّف Google Analytics 4 (اختياري) — بصيغة G-XXXXXXXXXX
# إن تُرك فارغًا لا يُحمَّل أي سكربت تتبّع إطلاقًا.
# التتبّع يعمل على الصفحات العامة فقط ولا يعمل داخل /admin.
NEXT_PUBLIC_GA_ID=

# سرّا مسارَي الأخبار /api/news/sync و /api/news/webhook — مطلوبان في الإنتاج:
# المساران يرفضان أي طلب إذا لم يُضبط السرّ (fail closed).
CRON_SECRET=
WEBHOOK_SECRET=
