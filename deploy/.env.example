# VPS-side configuration. Copy to deploy/.env, fill via deploy/gen-keys.sh.
# Never commit deploy/.env.

# Public hostnames (A records must point at the VPS)
APP_HOST=najdat.example.dz
SUPABASE_HOST=supabase.najdat.example.dz
STUDIO_HOST=studio.najdat.example.dz

# Image tag to run — overwritten by deploy.sh on every release
APP_TAG=latest

# From gen-keys.sh
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=
CRON_SECRET=
WEBHOOK_SECRET=

# Studio protection (Caddy basic auth)
STUDIO_USER=admin
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '...'
STUDIO_PASSWORD_HASH=
